datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  stripeCustomerId   String?
  subscriptionStatus String?
  users              User[]
  clienti            Cliente[]
  impianti           Impianto[]
  cantieri           Cantiere[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  image          String?
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts       Account[]
  sessions       Session[]
}

model Cliente {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  originalId     String?      @unique
  nome           String
  indirizzo      String?
  partitaIva     String?
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cantieri       Cantiere[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Cantiere {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  originalId     String?      @unique
  nome           String
  clienteId      String       @db.ObjectId
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  impianti       Impianto[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Impianto {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  originalId         String?      @unique
  tipoImpianto       String       // "ImpiantoStandard", "QuadroBT", ecc.
  codIntervento      String
  nomeCompleto       String
  premessa           String?
  quantita           Int          @default(1)
  noteSpecifiche     String?

  // Embedded activities
  listaAttivita      AttivitaItem[]

  // Relations
  cantiereId         String?      @db.ObjectId
  cantiere           Cantiere?    @relation(fields: [cantiereId], references: [id])
  organizationId     String       @db.ObjectId
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Extra fields stored as JSON depending on the type
  extraData          Json?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

type AttivitaItem {
  nAttivita      Int
  tipoAttivita   String?
  descrizione    String?
  visibile       Boolean @default(true)
  componentRef   String?
  targetImpiantoCod String?
  frequenza      Periodo
}

type Periodo {
  tipo   String // 'M' or 'A'
  valore Int
}
